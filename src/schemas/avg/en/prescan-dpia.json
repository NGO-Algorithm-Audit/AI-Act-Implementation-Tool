{
  "JSONSchema": {
    "title": "Pre-scan DPIA",
    "type": "object",
    "definitions": {
      "outputPrescanDpia": {
        "type": "string",
        "title": "Uitkomst",
        "default": "",
        "prescanDpia": true
      }
    },
    "properties": {
      "q1": {
        "type": "string",
        "title": "Betreft de scope van de verwerking nieuwe wet- of regelgeving?",
        "enum": [
          "Ja",
          "Nee"
        ]
      }
    },
    "required": [
      "q1"
    ],
    "dependencies": {
      "q1": {
        "oneOf": [
          {
            "properties": {
              "q1": {
                "enum": [
                  "Ja"
                ]
              },
              "output": {
                "$ref": "#/definitions/outputPrescanDpia"
              }
            }
          },
          {
            "properties": {
              "q1": {
                "enum": [
                  "Nee"
                ]
              },
              "q2": {
                "type": "array",
                "title": "Welke gewone persoonsgegevens gaat het systeem verwerken?",
                "items": {
                  "type": "string",
                  "enum": [
                    "Apparaat- en internetgegevens",
                    "Content",
                    "Demografische gegevens",
                    "Diagnostische gegevens of telemetrie",
                    "Gegevens verzameld via een website",
                    "Helpdeskgegevens",
                    "Logging",
                    "Naam, contactgegevens",
                    "Overige",
                    "Geen van de bovenstaande"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "q3": {
                "type": "array",
                "title": "Welke bijzondere persoonsgegevens gaat het systeem verwerken?",
                "items": {
                  "type": "string",
                  "enum": [
                    "Biometrische gegevens met het oog op de unieke identificatie van een persoon",
                    "Gegevens met betrekking tot iemands seksueel gedrag of seksuele gerichtheid",
                    "Gegevens over gezondheid",
                    "Genetische gegevens",
                    "Persoonsgegevens waaruit het lidmaatschap van een vakbond blijkt",
                    "Persoonsgegevens waaruit politieke opvattingen blijken",
                    "Persoonsgegevens waaruit ras of etnische afkomst blijkt",
                    "Persoonsgegevens waaruit religieuze of levensbeschouwelijke overtuigingen blijken",
                    "Geen van de bovenstaande"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "q4": {
                "type": "array",
                "title": "Welke andere gevoelige persoonsgegevens gaat het systeem verwerken?",
                "items": {
                  "type": "string",
                  "enum": [
                    "Surfgedrag",
                    "Gegevens over de financiële situatie van de betrokkene",
                    "Gegevens die kunnen worden gebruikt voor (identiteits)fraude",
                    "Gegevens die betrekking hebben op kwetsbare groepen",
                    "Gebruikersnamen, wachtwoorden en andere inloggegevens",
                    "Communicatie- en locatiegegevens",
                    "Nationale identificatienummers (bijv. BSN)",
                    "Strafrechtelijke gegevens",
                    "Andere gegevens die kunnen leiden tot stigmatisering of uitsluiting van de betrokkene",
                    "Geen van de bovenstaande"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "q5": {
                "type": "array",
                "title": "Welke categorieën betrokkenen kun je onderscheiden?",
                "items": {
                  "type": "string",
                  "enum": [
                    "Medewerkers/bewindspersonen",
                    "Burgers over wie gegevens worden verwerkt in het proces/systeem/applicatie",
                    "Kinderen jonger dan 16 jaar",
                    "Andere kwetsbare groepen (gehandicapten, minderheden, etc.)",
                    "Specificatie categorie betrokkenen (bijv. vanuit uitvoeringswetgeving)",
                    "Geen van de bovenstaande"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "q6": {
                "type": "string",
                "title": "Is het totale aantal betrokkenen gelijk aan of groter dan 10.000?",
                "enum": [
                  "Ja",
                  "Nee"
                ]
              },
              "q7": {
                "type": "string",
                "title": "Is de hoeveelheid gegevens die wordt verwerkt van alle betrokkenen gelijk aan of groter dan 10.000?",
                "enum": [
                  "Ja",
                  "Nee"
                ]
              },
              "q8": {
                "type": "string",
                "title": "Wat is de frequentie van de verwerking?",
                "enum": [
                  "Continu",
                  "Vaker dan maandelijks",
                  "Minstens maandelijks",
                  "Minstens jaarlijks",
                  "Onregelmatig",
                  "Eenmalig"
                ]
              },
              "q9": {
                "type": "string",
                "title": "Wat is de bewaartermijn van de gegevens?",
                "enum": [
                  "Aantal jaren",
                  "Jaar",
                  "Minder dan 1 maand",
                  "Minder dan 1 week",
                  "Minder dan 24 uur"
                ]
              },
              "q10": {
                "type": "string",
                "title": "Is er sprake van internationale doorgifte van persoonsgegevens buiten de Europese Economische Ruimte (EER)?",
                "enum": [
                  "Ja, inclusief bijzondere persoonsgegevens",
                  "Ja, zonder bijzondere persoonsgegevens",
                  "Nee"
                ]
              },
              "q11": {
                "type": "array",
                "title": "Van welke basisregistraties wordt gebruikgemaakt?",
                "items": {
                  "type": "string",
                  "enum": [
                    "Basisregistratie Grootschalige Topografie (BGT)",
                    "Basisregistratie Inkomen (BRI)",
                    "Basisregistratie Kadaster (BRK)",
                    "Basisregistratie Ondergrond (BRO)",
                    "Basisregistratie Personen (BRP)",
                    "Basisregistratie Topografie (BRT)",
                    "Basisregistratie Voertuigen (BRV)",
                    "Basisregistratie Waarde Onroerende Zaken (WOZ)",
                    "Handelsregister (HR)",
                    "Basisregistratie Adressen en Gebouwen (BAG)",
                    "Geen van de bovenstaande"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "q12": {
                "type": "string",
                "title": "Biedt u een digitale dienst aan of gebruikt u deze?",
                "enum": [
                  "Ja, primair bedoeld voor gebruik door personen jonger dan 18 jaar",
                  "Ja, niet primair bedoeld voor personen jonger dan 18 jaar",
                  "Nee"
                ]
              },
              "q13": {
                "type": "array",
                "title": "Valt de verwerking onder een of meer categorieën van de lijst van de Autoriteit Persoonsgegevens (AP)?",
                "items": {
                  "type": "string",
                  "enum": [
                    "Biometrische gegevens",
                    "Cameratoezicht",
                    "Communicatiegegevens",
                    "Controle werknemers",
                    "Creditscores",
                    "Financiële situatie",
                    "Flexibel cameratoezicht",
                    "Fraudebestrijding",
                    "Genetische persoonsgegevens",
                    "Gezondheidsgegevens",
                    "Heimelijk onderzoek",
                    "Internet of things",
                    "Profilering",
                    "Observatie en beïnvloeding van gedrag",
                    "Locatiegegevens",
                    "Samenwerkingsverbanden",
                    "Zwarte lijsten",
                    "Geen van de bovenstaande"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "q14": {
                "type": "array",
                "title": "Valt de verwerking onder een of meer criteria van de lijst van de EDPB?",
                "items": {
                  "type": "string",
                  "enum": [
                    "Bijzondere persoonsgegevens of zeer gevoelige persoonsgegevens",
                    "Blokkering van een dienst, recht of contract",
                    "Geautomatiseerde besluitvorming",
                    "Gebruik van nieuwe technologieën",
                    "Grootschalige gegevensverwerkingen",
                    "Koppelen van datasets",
                    "Mensen beoordelen met persoonskenmerken (evaluatie of scoring)",
                    "Stelselmatige en grootschalige monitoring",
                    "Verwerking van persoonsgegevens over kwetsbare groepen of personen",
                    "Geen van de bovenstaande"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "output": {
                "$ref": "#/definitions/outputPrescanDpia"
              }
            },
            "required": [
              "q2",
              "q3",
              "q4",
              "q5",
              "q6",
              "q7",
              "q8",
              "q9",
              "q10",
              "q11",
              "q12",
              "q13",
              "q14"
            ]
          }
        ]
      }
    }
  },
