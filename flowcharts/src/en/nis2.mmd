%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'Avenir Next, Avenir, Helvetica, sans-serif', 'fontSize': '14px', 'lineColor': '#005AA7', 'primaryColor': '#005AA7', 'edgeLabelBackground': '#ffffff'}, 'flowchart': {'curve': 'basis', 'useMaxWidth': false, 'htmlLabels': true, 'nodeSpacing': 100, 'rankSpacing': 140, 'padding': 24}}}%%
flowchart LR

    classDef Q fill:#daeaf7,stroke:#005aa7,color:#000
    classDef cat_ess fill:#6f42c1,stroke:#4f2c91,color:#fff,font-weight:bold
    classDef cat_imp fill:#0891b2,stroke:#076a8d,color:#fff,font-weight:bold
    classDef cat_member fill:#6c757d,stroke:#6c757d,color:#fff,font-weight:bold
    classDef cat_out fill:#f5f5f5,stroke:#adb5bd,color:#495057,font-weight:bold
    classDef cat_desig fill:#4f46e5,stroke:#3730a3,color:#fff,font-weight:bold
    classDef cat_reg fill:#e0e7ff,stroke:#4f46e5,color:#1e1b4b,font-weight:bold
    linkStyle default stroke:#005AA7,stroke-width:1.2px

    %% ════════ Q1 — EU presence ════════
    Q1["Q1 · Art. 2 · Art. 26 NIS2<br/>Established in the EU, or<br/>providing services or activities<br/>in the EU?"]:::Q
    Q1 -->|"No"| NOTEU
    Q1 -->|"Yes"| Q2

    %% ════════ Q2 — categories always in scope (size may still decide essential vs important) ════════
    Q2["Q2 · Art. 2(2)–(4) · Art. 3(1) NIS2<br/>Does the organisation belong<br/>to a category that is<br/>always in scope?"]:::Q
    Q2 -->|"Qualified TSP, TLD<br/>registry or DNS provider"| ESS
    Q2 -->|"Central government<br/>entity"| ESS
    Q2 -->|"Critical entity<br/>(CER Directive)"| ESS
    Q2 -->|"Identified by the government<br/>(Art. 2(2)(b)–(e))"| DESIG
    Q2 -->|"Public electronic<br/>communications provider"| Q4A
    Q2 -->|"Non-qualified trust<br/>service provider"| Q4B
    Q2 -->|"Domain name<br/>registration services"| REG
    Q2 -->|"None of the above"| Q3

    %% ════════ Q3 — sector ════════
    Q3["Q3 · Annex I · Annex II NIS2<br/>In which sector is the<br/>organisation active?"]:::Q
    Q3 -->|"Annex I sector<br/>(high criticality)"| Q4C
    Q3 -->|"Annex II sector<br/>(other critical)"| Q4D
    Q3 -->|"Regional or local<br/>public administration"| PUBADM
    Q3 -->|"None of these sectors"| OUT

    %% ════════ Q4 — size (SME Recommendation 2003/361/EC), one screen per route ════════
    Q4A["Q4 · Art. 3(1)(a), (c) · 3(2) NIS2<br/>Essential or important?<br/>Size of the organisation<br/>(electronic communications)"]:::Q
    Q4A -->|"Large or medium-sized"| ESS
    Q4A -->|"Small or micro"| IMP

    Q4B["Q4 · Art. 3(1)(a) · 3(2) NIS2<br/>Essential or important?<br/>Size of the organisation<br/>(non-qualified TSP)"]:::Q
    Q4B -->|"Large"| ESS
    Q4B -->|"Medium-sized, small or micro"| IMP

    Q4C["Q4 · Art. 2(1) · Art. 3(1)(a) NIS2<br/>Size of the organisation?<br/>(Annex I sector)"]:::Q
    Q4C -->|"Large"| ESS
    Q4C -->|"Medium-sized"| IMP
    Q4C -->|"Small or micro"| OUTSMALL

    Q4D["Q4 · Art. 2(1) · Art. 3(2) NIS2<br/>Size of the organisation?<br/>(Annex II sector)"]:::Q
    Q4D -->|"Large or medium-sized"| IMP
    Q4D -->|"Small or micro"| OUTSMALL

    %% ════════ Outcomes ════════
    ESS["Essential entity<br/>(Art. 3(1) NIS2; duty of care,<br/>incident reporting, registration,<br/>ex-ante supervision — Art. 32)"]:::cat_ess
    IMP["Important entity<br/>(Art. 3(2) NIS2; duty of care,<br/>incident reporting, registration,<br/>ex-post supervision — Art. 33)"]:::cat_imp
    DESIG["Essential or important entity<br/>as stated in the identification<br/>(Art. 3(1)(e) or 3(2) NIS2)"]:::cat_desig
    REG["In scope — domain name registration<br/>(Art. 2(4), 3(3) NIS2; not essential or<br/>important; registration Art. 27,<br/>registration data Art. 28)"]:::cat_reg
    PUBADM["Member state decides<br/>(regional: Art. 2(2)(f)(ii) NIS2,<br/>important entity if in scope;<br/>local: Art. 2(5)(a) NIS2;<br/>check designation in the Cbw)"]:::cat_member
    OUTSMALL["Not in scope — size<br/>(Art. 2(1) NIS2; unless designated<br/>under Art. 2(2)(b)–(e))"]:::cat_out
    OUT["Not in scope of NIS2<br/>(member state may still<br/>designate — Art. 2(2))"]:::cat_out
    NOTEU["NIS2 does not apply<br/>(no services or activities<br/>in the EU)"]:::cat_out
