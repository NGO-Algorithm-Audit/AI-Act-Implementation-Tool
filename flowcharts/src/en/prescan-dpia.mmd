%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'Avenir Next, Avenir, Helvetica, sans-serif', 'fontSize': '14px', 'lineColor': '#005AA7', 'primaryColor': '#005AA7', 'edgeLabelBackground': '#ffffff', 'clusterBkg': '#f2f7fb', 'clusterBorder': '#9dbcd8', 'titleColor': '#005AA7'}, 'flowchart': {'curve': 'basis', 'useMaxWidth': false, 'htmlLabels': true, 'nodeSpacing': 50, 'rankSpacing': 80, 'padding': 20}}}%%
flowchart LR

    classDef Q fill:#daeaf7,stroke:#005aa7,color:#000
    classDef score fill:#ffffff,stroke:#9dbcd8,color:#1e3a8a
    classDef gate fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,font-weight:bold
    classDef req fill:#dc3545,stroke:#dc3545,color:#fff,font-weight:bold
    classDef rec fill:#0d9488,stroke:#0d9488,color:#fff,font-weight:bold
    classDef none fill:#6c757d,stroke:#6c757d,color:#fff
    linkStyle default stroke:#005AA7,stroke-width:1.2px

    START(["Start pre-scan"]):::gate

    %% ════════ Q1 — new legislation or regulations ════════
    Q1["1 · Scope<br/>New legislation or<br/>regulations?"]:::Q
    DPIA_V["DPIA mandatory"]:::req
    DPIA_A["DPIA recommended"]:::rec
    DPIA_N["No DPIA advice"]:::none
    START --> Q1
    Q1 -->|"Yes"| DPIA_V
    Q1 -->|"No"| RS

    %% ════════ Q2–Q10 — risk-score questions, summed in Σ ════════
    subgraph RS["Risk score per question (0 / 1 / 2) — summed in Σ"]
        direction TB
        Q2["2 · Ordinary personal data<br/>≥ 6 categories → 1"]:::score
        Q3["3 · Special categories of personal data<br/>1–6 → 1 & > 6 → 2"]:::score
        Q4["4 · Sensitive personal data<br/>1–6 → 1 & > 6 → 2"]:::score
        Q5["5 · Categories of data subjects (weighted;<br/>children < 16 and vulnerable groups × 3)<br/>= 3 → 1 & ≥ 4 → 2"]:::score
        Q6["6 · ≥ 10,000 data subjects → 1"]:::score
        Q7["7 · Amount of data ≥ 10,000<br/>does not count towards Σ"]:::score
        Q8["8 · Frequency ≥ monthly → 1"]:::score
        Q9["9 · Retention period one year or longer → 1"]:::score
        Q10["10 · Transfer outside the EEA → 1<br/>incl. special categories → 2"]:::score
        Q2 ~~~ Q3 ~~~ Q4 ~~~ Q5 ~~~ Q6 ~~~ Q7 ~~~ Q8 ~~~ Q9 ~~~ Q10
    end

    %% ════════ Σ check, Q11 processing activities, AP list and EDPB criteria ════════
    SUM["Σ risk score > 4?"]:::gate
    Q11["11 · Processing activities<br/>(camera surveillance, profiling,<br/>linking datasets, …)"]:::Q
    AP["AP list ≥ 1 item?<br/>Q11 + Q3/Q4 data if<br/>large-scale or systematic"]:::gate
    EDPB["EDPB criteria<br/>Q11 + Q3–Q7<br/>Number of criteria?"]:::gate
    RS --> SUM
    SUM -->|"Yes"| DPIA_V
    SUM -->|"No"| Q11
    Q11 --> AP
    AP -->|"Yes"| DPIA_V
    AP -->|"No"| EDPB
    EDPB -->|"≥ 2"| DPIA_V
    EDPB -->|"1"| DPIA_A
    EDPB -->|"0"| DPIA_N

    %% The invisible ~~~ chain (Q2–Q10, links 3–10) inherits linkStyle default; hide it explicitly.
    linkStyle 3,4,5,6,7,8,9,10 stroke:none,stroke-width:0px
