%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'Avenir Next, Avenir, Helvetica, sans-serif', 'fontSize': '14px', 'lineColor': '#005AA7', 'primaryColor': '#005AA7', 'edgeLabelBackground': '#ffffff'}, 'flowchart': {'curve': 'basis', 'useMaxWidth': false, 'htmlLabels': true, 'nodeSpacing': 80, 'rankSpacing': 110, 'padding': 24}}}%%
flowchart LR

    classDef Q fill:#daeaf7,stroke:#005aa7,color:#000
    classDef cat_algo fill:#fd7e14,stroke:#fd7e14,color:#fff,font-weight:bold
    classDef cat_none fill:#f5f5f5,stroke:#adb5bd,color:#6c757d
    linkStyle default stroke:#005AA7,stroke-width:1.2px

    %% ════════ Phase 1 — does the routing even allow an algorithm? ════════
    Q1["Q1 · Outcome of the<br/>application?"]:::Q
    Q1 -->|"score / label / recommendation /<br/>decision / content / recognition"| Q2
    Q1 -->|"only dashboard or only other"| NONE_RULES["❌ Not a high-impact algorithm<br/>(rule-based / non-actionable)"]:::cat_none

    Q2["Q2 · Is the design<br/>based on data?"]:::Q
    Q2 -->|"Data-inspired"| Q8
    Q2 -->|"Data-derived"| Q8
    Q2 -->|"No data"| Q3

    Q3["Q3 · Automation of rules<br/>defined by humans?"]:::Q
    Q3 -->|"One-to-one with legislation"| NONE_RULES
    Q3 -->|"Informal rules or No"| Q8
    Q3 -->|"Symbolic AI"| Q8

    %% ════════ Phase 3 — impact gating (Phase 2 is irrelevant for algo) ════════
    Q8["Q8 · Decision made for<br/>individual citizens,<br/>organisations, or employees?"]:::Q
    Q8 -->|"No"| Q11
    Q8 -->|"Yes"| Q9

    Q11["Q11 · Does the process contribute<br/>to how the government categorises<br/>or approaches groups?"]:::Q
    Q11 -->|"No"| NONE_NOIMPACT["❌ Not a high-impact algorithm"]:::cat_none
    Q11 -->|"Yes or Unsure"| Q12

    Q9["Q9 · Type of decision?"]:::Q
    Q9 -->|"other"| NONE_NOIMPACT
    Q9 -->|"prioritisation"| Q12
    Q9 -->|"formal complaints · financial ·<br/>schools · eligibility · legal"| Q12
    Q9 -->|"inspection"| Q10

    Q10["Q10 · Particularly intrusive?"]:::Q
    Q10 -->|"Yes or No"| Q12

    Q12["Q12 · Effect on outcome?"]:::Q
    Q12 -->|"directly determines"| ALGO_OK["High-impact algorithm"]:::cat_algo
    Q12 -->|"partially influences"| ALGO_OK
    Q12 -->|"fully human / other"| NONE_NOIMPACT
