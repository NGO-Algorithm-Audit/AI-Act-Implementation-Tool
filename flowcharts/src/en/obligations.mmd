flowchart LR

    classDef Q fill:#daeaf7,stroke:#005aa7,color:#000
    classDef exc fill:#eff6ff,stroke:#3b82f6,color:#1e3a8a
    classDef cat_forb fill:#dc3545,stroke:#a01c2a,color:#fff,font-weight:bold
    classDef cat_high fill:#d97706,stroke:#a05705,color:#fff,font-weight:bold
    classDef cat_genai fill:#FFBF00,stroke:#b88a00,color:#fff,font-weight:bold
    classDef role_prov fill:#6f42c1,stroke:#4f2c91,color:#fff,font-weight:bold
    classDef role_dep fill:#0891b2,stroke:#076a8d,color:#fff,font-weight:bold
    classDef oblig_forb fill:#fbe2e4,stroke:#dc3545,color:#000
    classDef oblig_high fill:#fdecd0,stroke:#d97706,color:#000
    classDef oblig_genai fill:#f1f3f5,stroke:#9aa3ab,color:#000
    classDef cat_exempt fill:#0d9488,stroke:#0d9488,color:#fff,font-weight:bold
    classDef cat_except fill:#6c757d,stroke:#6c757d,color:#fff,font-weight:bold
    linkStyle default stroke:#005AA7,stroke-width:1.2px

    Q1["Risk category<br/>(determined by the<br/>Risk-category questionnaire)"]:::Q
    Q1 -->|"Prohibited<br/>Art. 5"| FORB
    Q1 -->|"High-risk<br/>Art. 6 + Annex III"| HIGH
    Q1 -->|"Generative and interactive<br/>Art. 50"| GENAI

    FORB["Prohibited<br/>AI system"]:::cat_forb
    HIGH["High-risk<br/>AI system"]:::cat_high
    GENAI["Generative and<br/>interactive AI system"]:::cat_genai

    FORB --> Q2F["Role"]:::Q
    HIGH --> Q2H["Role"]:::Q
    GENAI --> AQ1

    Q2F -->|"Provider"| FP
    Q2F -->|"Deployer"| FD
    Q2H -->|"Provider"| HP
    Q2H -->|"Deployer"| HD

    %% ════════ Art. 50 detail questionnaire (started from the Obligations menu)
    %% — its own Q1-Q7 numbering, matching the tool's live question badges ════════
    AQ1["Q1 · Art. 50<br/>Which of the following<br/>scenarios apply to the<br/>AI system? (multi-select)"]:::Q
    AQ1 -->|"None of the above"| NOART50
    AQ1 -->|"At least one<br/>scenario"| EXCEPTIONS

    NOART50["No requirements<br/>(Art. 50)"]:::cat_exempt

    %% ════════ Shared Article 2 scope-exclusion screen (guidelines §2.4), asked
    %% once right after Q1, before any scenario-specific exception check ════════
    EXCEPTIONS["Exception screen · Art. 50<br/>Personal use, research or<br/>open-source licence?"]:::exc
    EXCEPTIONS -->|"None —<br/>interactive AI"| AQ2
    EXCEPTIONS -->|"None —<br/>synthetic content"| AQ3
    EXCEPTIONS -->|"None —<br/>biometric / emotion"| AQ4
    EXCEPTIONS -->|"None —<br/>deep fake"| AQ5
    EXCEPTIONS -->|"None —<br/>public-interest text"| AQ6
    EXCEPTIONS -->|"Exception applies"| EXEMPT0

    %% ════════ Each scenario's own exception check (multi-select — any ground
    %% checked resolves the same way; the shared exception screen above already
    %% ruled out the general exception, so "None" here resolves directly, no
    %% further screen). Every ground that resolves to exempt is merged into one
    %% "Exception applies" edge. Each scenario gets its own identical outcome
    %% box (rather than one shared node) so its edge never has to converge with
    %% another scenario's — the same duplication convention already used for
    %% Provider/Deployer/Role throughout this diagram ════════
    AQ2["Q2 · Art. 50(1)<br/>Exception to interactive-AI<br/>disclosure? (multi-select)"]:::Q
    AQ2 -->|"None"| S1R
    AQ2 -->|"Exception applies"| EXEMPT2

    AQ3["Q3 · Art. 50(2)<br/>Exception to synthetic-content<br/>marking? (multi-select)"]:::Q
    AQ3 -->|"None"| S2R
    AQ3 -->|"Exception applies"| EXEMPT3

    AQ4["Q4 · Art. 50(3)<br/>Used for law-enforcement<br/>purposes?"]:::Q
    AQ4 -->|"No"| S3R
    AQ4 -->|"Yes"| EXEMPT4

    AQ5["Q5 · Art. 50(4)<br/>Exception or attenuated<br/>regime for deep fakes?<br/>(multi-select)"]:::Q
    AQ5 -->|"None"| S4R
    AQ5 -->|"Evidently artistic /<br/>creative / satirical /<br/>fictional work"| S4_ATT_O
    AQ5 -->|"Exception applies"| EXEMPT5

    AQ6["Q6 · Art. 50(4)<br/>Exception to public-interest-<br/>text disclosure? (multi-select)"]:::Q
    AQ6 -->|"None"| S5R
    AQ6 -->|"Exception applies"| EXEMPT6

    EXEMPT0["Transparency obligations<br/>+ possible exception"]:::cat_except
    EXEMPT2["Transparency obligations<br/>+ possible exception"]:::cat_except
    EXEMPT3["Transparency obligations<br/>+ possible exception"]:::cat_except
    EXEMPT4["Transparency obligations<br/>+ possible exception"]:::cat_except
    EXEMPT5["Transparency obligations<br/>+ possible exception"]:::cat_except
    EXEMPT6["Transparency obligations<br/>+ possible exception"]:::cat_except

    S1R["Role"]:::Q
    S2R["Role"]:::Q
    S3R["Role"]:::Q
    S4R["Role"]:::Q
    S5R["Role"]:::Q

    S1R -->|"Provider"| S1P
    S1R -->|"Deployer"| S1D
    S2R -->|"Provider"| S2P
    S2R -->|"Deployer"| S2D
    S3R -->|"Provider"| S3P
    S3R -->|"Deployer"| S3D
    S4R -->|"Provider"| S4P
    S4R -->|"Deployer"| S4D
    S5R -->|"Provider"| S5P
    S5R -->|"Deployer"| S5D

    FP["Provider"]:::role_prov
    FD["Deployer"]:::role_dep
    HP["Provider"]:::role_prov
    HD["Deployer"]:::role_dep
    S1P["Provider"]:::role_prov
    S1D["Deployer"]:::role_dep
    S2P["Provider"]:::role_prov
    S2D["Deployer"]:::role_dep
    S3P["Provider"]:::role_prov
    S3D["Deployer"]:::role_dep
    S4P["Provider"]:::role_prov
    S4D["Deployer"]:::role_dep
    S5P["Provider"]:::role_prov
    S5D["Deployer"]:::role_dep

    FP --> FP_O["Take the AI system out of service immediately. Do not place it on the market, put it into service or use it within the European Union.<br/>Source: Art. 5 AI Act"]:::oblig_forb

    FD --> FD_O["Stop using the AI system. Inform the provider that the system must be taken out of service immediately. Do not use within the European Union.<br/>Source: Art. 5 AI Act"]:::oblig_forb

    HP --> HP_O["Obligations for the provider of a high-risk AI system:<br/>1. Risk management system (Art. 9)<br/>2. Data and data governance (Art. 10)<br/>3. Technical documentation — Annex IV — before placing on the market (Art. 11)<br/>4. Record-keeping and logging — retain logs ≥ 6 months (Art. 12)<br/>5. Transparency and instructions to deployers (Art. 13)<br/>6. Human oversight and meaningful human intervention (Art. 14)<br/>7. Accuracy, robustness and cybersecurity (Art. 15)<br/>8. Quality management system, incl. post-market monitoring (Art. 17)<br/>9. Conformity assessment — self- or third-party (Art. 43)<br/>10. EU Declaration of Conformity (Art. 47)<br/>11. CE marking (Art. 48)<br/>12. Registration in the EU database before placing on the market (Art. 49)<br/>13. Post-market monitoring &amp; serious-incident reporting (Art. 72)<br/>14. AI literacy of staff (Art. 4)<br/>Source: Art. 16 AI Act"]:::oblig_high

    HD --> HD_O["Obligations for the deployer of a high-risk AI system:<br/>1. Use the system in accordance with the instructions for use (Art. 26(1))<br/>2. Assign human oversight to competent persons (Art. 26(2))<br/>3. Where the deployer controls input data, ensure relevance &amp; representativeness (Art. 26(4))<br/>4. Monitor operation and report risks / serious incidents to the provider, distributor and market-surveillance authority (Art. 26(5))<br/>5. Keep automatically generated logs ≥ 6 months (Art. 26(6))<br/>6. Inform workers' representatives and affected workers before workplace deployment (Art. 26(7))<br/>7. Inform natural persons that they are subject to a high-risk AI system (Art. 26(11))<br/>8. Fundamental Rights Impact Assessment before deployment — for public bodies and certain private deployers of Annex III systems (Art. 27)<br/>Source: Art. 26 AI Act"]:::oblig_high

    S1P --> S1P_O["Obligations for AI interacting directly with natural persons:<br/>1. Design and develop the AI system so that natural persons are clearly informed they are interacting with an AI system, unless this is obvious from the perspective of a reasonably well-informed natural person, taking into account the circumstances and context of use.<br/>2. The notification must be embedded in design and provided at the latest at the time of the first interaction (Art. 50(5)).<br/>3. Information must be clear, distinguishable, accessible (incl. for vulnerable groups: children, elderly, persons with disabilities) and given in a context-appropriate manner.<br/>Timing: Provide information to users at the latest at the time of the first exposure to the system.<br/>Exception: Systems permitted by law to detect, prevent or investigate criminal offences, with appropriate safeguards under Union law.<br/>Source: Art. 50(1) AI Act"]:::oblig_genai

    S1D --> S1D_O["Obligations for AI interacting directly with natural persons:<br/>1. Verify that the provider has implemented the disclosure of interactive AI (e.g. an opening line from a chatbot, a clear 'AI assistant' label, or equivalent signal).<br/>2. Double-check that your own configuration, branding, or integration of the system does not undermine or remove the provider's disclosure. If you fine-tune, rebrand, or substantially modify the system, Article 25 may convert you into a provider, importing full Article 50(1) provider duties.<br/>Timing: Provide information to users at the latest at the time of the first exposure to the system.<br/>Exception: Systems permitted by law to detect, prevent or investigate criminal offences, with appropriate safeguards under Union law.<br/>Source: Art. 50(1) AI Act"]:::oblig_genai

    S2P --> S2P_O["Obligations for AI generating synthetic audio, image, video or text content:<br/>1. Marking: outputs must be marked in a machine-readable format (e.g. watermarks, metadata, cryptographic provenance methods, fingerprints).<br/>2. Detection: providers must make means available to detect that the output is AI-generated or manipulated, with human-readable results.<br/>3. Both elements must be present; marking alone is insufficient.<br/>Timing: Provide information to users at the latest at the time of the first exposure to the system.<br/>Exception: Systems permitted by law to detect, prevent or investigate criminal offences, with appropriate safeguards under Union law.<br/>Source: Art. 50(2) AI Act"]:::oblig_genai

    S2D --> S2D_O["The Art. 50(2) marking &amp; detection duty rests with the provider, not the deployer — there is no separate deployer duty under this scenario as such.<br/>1. If, as deployer, you also generate a deep fake or publish AI-generated public-interest text using this system, that triggers the separate Art. 50(4) deployer obligations — see 'Deep fakes' / 'Public-interest text' above.<br/>Source: Art. 50(2) AI Act"]:::oblig_genai

    S3P --> S3P_O["Inform exposed persons and process personal data per GDPR."]:::oblig_genai

    S3D --> S3D_O["Obligations for AI recognising emotions or categorising persons based on biometric data:<br/>1. Inform all natural persons exposed to the system that it is being operated / used.<br/>2. Provide information in a clear, distinguishable and accessible manner (Art. 50(5)).<br/>3. Information may be given in writing, via standardised icons, orally, electronically or any combination, depending on the deployment context.<br/>Timing: Provide information to users at the latest at the time of the first exposure to the system.<br/>Exception: Systems permitted by law to detect, prevent or investigate criminal offences, with appropriate safeguards under Union law.<br/>Source: Art. 50(3) and Art. 50(5) AI Act"]:::oblig_genai

    S4P --> S4P_O["The obligations under Article 50(4) only apply to deployers of the AI system"]:::oblig_genai

    S4D --> S4D_O["Obligations for AI generating or manipulating a deep fake (image, audio or video):<br/>1. Deployers of AI systems that generate deep fakes (as defined in Art. 3(60)) must disclose that the content has been artificially generated or manipulated.<br/>Timing: Provide information to users at the latest at the time of the first exposure to the content.<br/>Exception: Where the use is authorised by law to detect, prevent, investigate, or prosecute criminal offences.<br/>Source: Art. 50(4), 1st subparagraph, AI Act"]:::oblig_genai

    S4_ATT_O["Attenuated deep-fake disclosure (any role):<br/>1. The disclosure obligation is not removed, but for deep fakes that evidently form part of an artistic, creative, satirical, fictional or analogous work or programme, it can be given in a form that does not hamper the display or enjoyment of the work (e.g. in end credits rather than an on-screen banner).<br/>2. Appropriate safeguards for the rights and freedoms of third parties (e.g. personal data, intellectual property) still apply.<br/>Source: Art. 50(4), 1st subparagraph, &amp; Recital 134 AI Act"]:::oblig_genai

    S5P --> S5P_O["The obligations under Article 50(4) only apply to deployers of the AI system"]:::oblig_genai

    S5D --> S5D_O["Obligations for AI generating or manipulating public-interest text:<br/>1. Deployers must disclose that the text has been artificially generated or manipulated.<br/>Timing: Provide information to users at the latest at the time of the first exposure to the text.<br/>Exception: Where the use is authorised by law to detect, prevent, investigate, or prosecute criminal offences.<br/>Source: Art. 50(4), 2nd subparagraph, AI Act"]:::oblig_genai

    %% Layout-only edge: pulls the attenuated-outcome box into the same rank
    %% column as the other outcome nodes, without altering the real AQ5 edge
    %% above. stroke:none makes this edge (and its arrowhead) fully invisible.
    S4D --> S4_ATT_O
    linkStyle 53 stroke:none
