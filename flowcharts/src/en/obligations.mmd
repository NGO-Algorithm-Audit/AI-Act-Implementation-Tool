    Q2F -->|"Provider"| FP
    Q2F -->|"Deployer"| FD
    Q2H -->|"Provider"| HP
    Q2H -->|"Deployer"| HD

    Q10 -->|"Interacts directly<br/>with natural persons"| S1
    Q10 -->|"Generates synthetic<br/>audio / image / video / text"| S2
    Q10 -->|"Recognises emotions or<br/>biometric categorisation"| S3
    Q10 -->|"Generates / manipulates<br/>public-interest content"| S4

    S1["Art. 50(1)<br/>Interactive AI"]:::scenario
    S2["Art. 50(2)<br/>Generative AI"]:::scenario
