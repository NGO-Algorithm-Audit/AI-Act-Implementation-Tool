%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'Avenir Next, Avenir, Helvetica, sans-serif', 'fontSize': '14px', 'lineColor': '#005AA7', 'primaryColor': '#005AA7', 'edgeLabelBackground': '#ffffff'}, 'flowchart': {'curve': 'basis', 'useMaxWidth': false, 'htmlLabels': true, 'nodeSpacing': 80, 'rankSpacing': 110, 'padding': 24}}}%%
flowchart LR

    classDef Q fill:#daeaf7,stroke:#005aa7,color:#000
    classDef cat_provider fill:#6f42c1,stroke:#6f42c1,color:#fff,font-weight:bold
    %% cat_pd: rendered as a BL→UR diagonal split (purple top, cyan bottom) via SVG patch in the .html wrapper.
    %% Standalone Mermaid renders the fallback solid purple fill.
    classDef cat_pd fill:#6f42c1,stroke:#003c70,color:#fff,font-weight:bold
    classDef cat_deployer fill:#0891b2,stroke:#0891b2,color:#fff,font-weight:bold
    classDef cat_importer fill:#65a30d,stroke:#65a30d,color:#fff,font-weight:bold
    classDef cat_distrib fill:#92400e,stroke:#92400e,color:#fff,font-weight:bold
    classDef cat_repr fill:#475569,stroke:#475569,color:#fff,font-weight:bold
    classDef cat_private fill:#0f766e,stroke:#0f766e,color:#fff,font-weight:bold
    classDef cat_inuse fill:#2563eb,stroke:#2563eb,color:#fff,font-weight:bold
    classDef cat_indev fill:#8b5cf6,stroke:#8b5cf6,color:#fff,font-weight:bold
    linkStyle default stroke:#005AA7,stroke-width:1.2px

    %% ════════ Q1 — how is the AI system developed or deployed ════════
    Q1["Q1 · How is the AI system<br/>developed or deployed?"]:::Q

    Q1 -->|"We develop and use<br/>the AI system ourselves"| ROLE_PD
    Q1 -->|"We only develop<br/>the AI system"| ROLE_P
    Q1 -->|"We develop the AI system<br/>and others also use it"| ROLE_PD
    Q1 -->|"We use an externally<br/>developed AI system"| Q2
    Q1 -->|"We import the AI system<br/>from a supplier outside the EU"| ROLE_I
    Q1 -->|"We buy the AI system from a<br/>supplier within the EU and resell it"| ROLE_X
    Q1 -->|"We represent a non-EU<br/>person or entity"| ROLE_R
    Q1 -->|"Natural person — purely personal,<br/>non-professional activity"| ROLE_PRIV

    %% ════════ Q2 — provider-status scenarios for an externally developed system ════════
    Q2["Q2 · Does one of the following<br/>scenarios apply to your AI system?"]:::Q
    Q2 -->|"The name or trademark of your<br/>organization is put on the AI system"| ROLE_P
    Q2 -->|"A substantial modification<br/>has been made to the AI system"| ROLE_P
    Q2 -->|"The intended purpose is<br/>modified by your organization"| ROLE_P
    Q2 -->|"None of the above"| ROLE_D

    %% ════════ Roles ════════
    ROLE_P["Provider"]:::cat_provider
    ROLE_PD["Provider + Deployer"]:::cat_pd
    ROLE_D["Deployer"]:::cat_deployer
    ROLE_I["Importer"]:::cat_importer
    ROLE_X["Distributor"]:::cat_distrib
    ROLE_R["Authorised representative"]:::cat_repr
    ROLE_PRIV["Private user<br/>Out of scope AI Act"]:::cat_private

    %% Personal non-professional use is terminal — no Q3
    ROLE_P & ROLE_PD & ROLE_D & ROLE_I & ROLE_X & ROLE_R --> Q3

    %% ════════ Q3 — AI system status ════════
    Q3["Q3 · Is the AI system<br/>already in use?"]:::Q
    Q3 -->|"In use (before AI Act entry into force)"| OUT_INUSE
    Q3 -->|"In development"| OUT_INDEV

    OUT_INUSE["In use<br/>comply by 2030<br/>(Art. 111 AI Act)"]:::cat_inuse
    OUT_INDEV["In development<br/>shorter deadlines per type<br/>(Art. 113 AI Act)"]:::cat_indev
