    %% Hoofdstuk 8 — Toetsing
    %% ════════════════════════════════════════════════════════════════════
    subgraph CH8["Hoofdstuk 8 · Toetsing"]
        direction LR
        E8["▶ Vanaf het NTA-scherm<br/>of Resultaat<br/>Hoofdstuk 7"]:::entry
        T1["§ 8.2 · Adviezen en besluitvorming<br/>Mandaat, technisch, ethisch en<br/>juridisch advies, en het besluit<br/>over ingebruikname<br/>(3 vereisten)"]:::Q
        T2["§ 8.3.1 · Doel en context van<br/>verificatie<br/>Gebruikte verificatiemethodes,<br/>de onderbouwing daarvan en<br/>de resultaten<br/>(2 vereisten)"]:::Q
        T3["§ 8.3.2 · Testdataset<br/>Onafhankelijke testdataset, of het<br/>verzamelen van nieuwe data als<br/>die er niet is<br/>(2 vereisten)"]:::Q
        T4["§ 8.3.3 · Schaduwdraaien<br/>Schaduwdraaien, vergelijking met het<br/>huidige besluitvormingsproces en<br/>verdeling over relevante gronden<br/>(3 vereisten)"]:::Q
        T5["§ 8.3.4 · Beoordelen prestaties<br/>en onderscheid<br/>Prestaties en onderscheid op de<br/>testdataset, getoetst aan de vooraf<br/>bepaalde bandbreedtes<br/>(4 vereisten)"]:::Q
        T6["§ 8.4 · Juridische toets<br/>Legitiem doel, geschiktheid,<br/>subsidiariteit, proportionaliteit en<br/>objectieve rechtvaardiging<br/>(5 vereisten)"]:::Q
        T7["§ 8.5 · Praktijkvalidatie<br/>Pilot op kleine schaal, evaluatie<br/>van de uitkomsten en een<br/>praktijkvalidatierapport<br/>(3 vereisten)"]:::Q
        T8["§ 8.6 · Onafhankelijke assessment<br/>of audit<br/>Processtappen van de NTA,<br/>algoritmebeleid en extern<br/>beleid valideren<br/>(3 vereisten)"]:::Q
        T9["§ 8.7 · Definitieve afweging<br/>Juridische toets herhalen en<br/>besluiten: implementeren,<br/>aanpassen of niet gebruiken<br/>(2 vereisten)"]:::Q
        REST["Resultaat<br/>Hoofdstuk 8<br/>vastgelegd"]:::cat_result
        E8 --> T1
        T1 --> T2 --> T3 --> T4 --> T5 --> T6 --> T7 --> T8 --> T9 --> REST
    end

