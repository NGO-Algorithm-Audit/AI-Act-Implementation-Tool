    %% Hoofdstuk 7 — Ontwerp en ontwikkeling
    %% ════════════════════════════════════════════════════════════════════
    subgraph CH7["Hoofdstuk 7 · Ontwerp en ontwikkeling"]
        direction LR
        E7["▶ Vanaf het NTA-scherm<br/>of Resultaat<br/>Hoofdstuk 6"]:::entry
        O1["§ 7.2 · Definieer en onderbouw<br/>doelvariabele<br/>Relatie met het doel, definitie,<br/>meetbaarheid, datakwaliteit en<br/>werkinstructies<br/>(5 vereisten)"]:::Q
        O2["§ 7.3.1 · Datasets<br/>Populatie en referentiepopulatie,<br/>(aselecte) steekproef, ontwikkel-,<br/>validatie- en testdataset<br/>(5 vereisten)"]:::Q
        O3["§ 7.3.2 · Datakwaliteit<br/>Accuraatheid, compleetheid,<br/>representativiteit, consistentie<br/>en actualiteit<br/>(5 vereisten)"]:::Q
        O4["§ 7.3.3 · Documentatie van datasets<br/>Herkomst en dataverzameling,<br/>samenstelling en bewerkingen<br/>(3 vereisten)"]:::Q
        O5["§ 7.4.2 · Kwalitatieve analyse<br/>Profileringskenmerken inventariseren,<br/>bezwaren wegen en de gemaakte<br/>keuzes onderbouwen<br/>(3 vereisten)"]:::Q
        O6["§ 7.4.3 · Kwantitatieve analyse<br/>Proxyanalyse op relevante gronden<br/>en dataminimalisatie<br/>(2 vereisten)"]:::Q
        O7["§ 7.5 · Algoritmekeuze<br/>Type algoritme onderbouwen en<br/>bepalen of het onderdeel is van een<br/>AI-systeem volgens de AI-verordening<br/>(2 vereisten)"]:::Q
        O8["§ 7.6 · Opstellen van<br/>profileringsalgoritme<br/>Regelgebaseerd: regels, drempel-<br/>waarden en gewichten. Datagebaseerd:<br/>training en gemaakte keuzes<br/>(2 vereisten)"]:::Q
        O9["§ 7.7.2 · Prestaties voor de<br/>doelvariabele<br/>Prestatiemetrieken en bandbreedtes<br/>bepalen, meten op de validatiedataset<br/>en resultaten uitleggen<br/>(6 vereisten)"]:::Q
        O10["§ 7.7.3 · Meten van indirect<br/>onderscheid<br/>Relevante gronden en gelijkheids-<br/>metrieken bepalen, onderscheid meten<br/>en resultaten uitleggen<br/>(6 vereisten)"]:::Q
        O11["§ 7.7.4 · Statistisch toetsen<br/>Effectgrootte, statistische<br/>significantie en hypothesetoetsen<br/>(3 vereisten)"]:::Q
        O12["§ 7.7.5 · Herziening van metrieken<br/>en bandbreedtes<br/>Motivatie vóór de fase Verificatie<br/>en validatie, en bij latere aanpassing<br/>in de levenscyclus<br/>(2 vereisten)"]:::Q
        O13["§ 7.8 · Documenteer ontwikkeling<br/>profileringsalgoritme<br/>Doelvariabele, algoritmetype,<br/>profileringskenmerken, methode<br/>en definitief algoritme<br/>(5 vereisten)"]:::Q
        RESO["Resultaat<br/>Hoofdstuk 7<br/>vastgelegd"]:::cat_result
