    %% ════════════════════════════════════════════════════════════
    %% Wenselijkheid en noodzakelijkheid
    %% ════════════════════════════════════════════════════════════
    subgraph CH_W["Wenselijkheid en noodzakelijkheid"]
        direction LR
        E_W["▶ Vanaf het NTA-scherm"]:::entry
        W1["Aanleiding en probleemverkenning<br/>Probleem, oorzaken, omvang<br/>en gevolgen van niet ingrijpen<br/>in kaart gebracht?<br/>(7 vereisten)"]:::Q
        W2["Doel en grondslag van het besluitvormingsproces<br/>Doel, wettelijke opdracht en<br/>bevoegdheid van het<br/>besluitvormingsproces<br/>onderbouwd?<br/>(7 vereisten)"]:::Q
        W3["Controle, handhaving en gedrag<br/>Bij toezicht of handhaving:<br/>effect op gedrag onderbouwd en<br/>minder ingrijpende opties<br/>overwogen?<br/>(2 vereisten)"]:::Q
        W4["Geraakte personen en stakeholders<br/>Geraakte personen en<br/>stakeholders in kaart gebracht,<br/>betrokken en hun belangen<br/>vastgelegd?<br/>(4 vereisten)"]:::Q
        W5["Alternatieven voor profilering<br/>Alternatieven voor profilering<br/>onderzocht en afgewogen, met<br/>inbreng van stakeholders?<br/>(6 vereisten)"]:::Q
        W6["Betrokken expertise en vertegenwoordiging<br/>Juridische, technische en<br/>ethische expertise en<br/>stakeholders bij bovenstaande<br/>stappen betrokken?<br/>(1 vereiste)"]:::Q
        W7["Beslismoment over verder ontwikkelen<br/>Afsluitend, multidisciplinair<br/>beslismoment over verder<br/>ontwikkelen gehouden?<br/>(1 vereiste)"]:::Q
        RES_W["Resultaat<br/>vastgelegd"]:::cat_result
        E_W --> W1
        W1 --> W2 --> W3 --> W4 --> W5 --> W6 --> W7 --> RES_W
    end

    %% ════════════════════════════════════════════════════════════
    %% Ontwerp en ontwikkeling
    %% ════════════════════════════════════════════════════════════
    subgraph CH_O["Ontwerp en ontwikkeling"]
        direction LR
        E_O["▶ Vanaf het NTA-scherm<br/>of Resultaat<br/>Wenselijkheid en noodzakelijkheid"]:::entry
        O1["Doelvariabele en dataset<br/>Keuze doelvariabele en dataset<br/>onderbouwd: relatie met doel,<br/>definitie, meetbaarheid en<br/>datakwaliteit?<br/>(6 vereisten)"]:::Q
        O2["Niet-categorische doelvariabele<br/>Als de doelvariabele niet<br/>categorisch is: onderbouwd<br/>waarom dat niet mogelijk of<br/>wenselijk was?<br/>(1 vereiste)"]:::Q
        O3["Werken met meerdere datasets<br/>Populatie, steekproef,<br/>ontwikkel-, validatie- en<br/>testdataset afgebakend?<br/>(5 vereisten)"]:::Q
        O4["Ontwikkeling zonder willekeurige steekproef<br/>Bij één dataset zonder<br/>willekeurige steekproef:<br/>afweging tegen alternatieven<br/>gemotiveerd vastgelegd?<br/>(1 vereiste)"]:::Q
        O5["Kwaliteit van de data<br/>Datakwaliteit beoordeeld op<br/>juistheid, volledigheid,<br/>representativiteit, samenhang<br/>en actualiteit?<br/>(5 vereisten)"]:::Q
        O6["Documentatie van de datasets<br/>Datasets gedocumenteerd op<br/>herkomst, opbouw en<br/>bewerkingen?<br/>(3 vereisten)"]:::Q
        O7["Kwalitatieve toets van kenmerken<br/>Selectiekenmerken<br/>multidisciplinair getoetst op<br/>juridische en ethische<br/>bezwaren?<br/>(5 vereisten)"]:::Q
        O8["Kwantitatieve toets van kenmerken<br/>Selectiekenmerken kwantitatief<br/>getoetst op verband met<br/>beschermde gronden<br/>(proxyanalyse)?<br/>(2 vereisten)"]:::Q
        O9["Keuze en onderbouwing van het type instrument<br/>Type instrument (regels, data-<br/>gedreven of combinatie)<br/>gekozen en onderbouwd?<br/>(5 vereisten)"]:::Q
        O10["Onderbouwing bij een regelgebaseerd instrument<br/>Bij een regelgebaseerd<br/>instrument: elke regel,<br/>drempelwaarde en gewicht<br/>onderbouwd?<br/>(1 vereiste)"]:::Q
        O11["Prestaties meten<br/>Prestaties gemeten op de<br/>validatiedataset, getoetst aan<br/>vooraf bepaalde marges?<br/>(6 vereisten)"]:::Q
        O12["Indirect onderscheid meten<br/>Indirect onderscheid tussen<br/>groepen multidisciplinair<br/>gemeten en getoetst aan<br/>marges?<br/>(6 vereisten)"]:::Q
        O13["Doorgaan zonder meting van onderscheid<br/>Als onderscheid niet meetbaar<br/>was: doorgaan onderbouwd met<br/>risicobeperkende maatregelen<br/>en monitoring?<br/>(5 vereisten)"]:::Q
        O14["Statistisch toetsen van de metingen<br/>Prestaties en onderscheid<br/>statistisch getoetst op toeval?<br/>(1 vereiste)"]:::Q
        O15["Herziening van maatstaven en marges<br/>Maatstaven en marges vooraf<br/>vastgesteld, met motivatie voor<br/>latere herziening?<br/>(1 vereiste)"]:::Q
        O16["Iteratief meten en beslissen<br/>Na elke iteratie prestaties en<br/>onderscheid herhaald tot beide<br/>aanvaardbaar zijn?<br/>(1 vereiste)"]:::Q
        O17["Beslismoment over verder ontwikkelen<br/>Afsluitend, multidisciplinair<br/>beslismoment over verder<br/>ontwikkelen gehouden?<br/>(1 vereiste)"]:::Q
        RES_O["Resultaat<br/>vastgelegd"]:::cat_result
        E_O --> O1
        O1 --> O2 --> O3 --> O4 --> O5 --> O6 --> O7 --> O8 --> O9 --> O10 --> O11 --> O12 --> O13 --> O14 --> O15 --> O16 --> O17 --> RES_O
    end

    %% ════════════════════════════════════════════════════════════
    %% Toetsing
    %% ════════════════════════════════════════════════════════════
    subgraph CH_T["Toetsing"]
        direction LR
        E_T["▶ Vanaf het NTA-scherm<br/>of Resultaat<br/>Ontwerp en ontwikkeling"]:::entry
        T1["Prestaties en onderscheid op de testdataset<br/>Prestaties en onderscheid<br/>opnieuw gemeten op de<br/>testdataset, binnen de vooraf<br/>bepaalde marges?<br/>(1 vereiste)"]:::Q
        T2["Juridische toets<br/>Getoetst op legitiem doel,<br/>geschiktheid, subsidiariteit en<br/>proportionaliteit?<br/>(4 vereisten)"]:::Q
        T3["Uitkomst van de juridische toets<br/>Instrument voldoet aan alle vier<br/>voorwaarden van de juridische<br/>toets?<br/>(1 vereiste)"]:::Q
        T4["Validatie in de praktijk<br/>Gevalideerd met een kleine,<br/>gedocumenteerde pilot met<br/>stopcriteria en evaluatie?<br/>(7 vereisten)"]:::Q
        T5["Onafhankelijke audit<br/>Ontwikkelproces onafhankelijk<br/>getoetst aan eigen normen,<br/>algoritmebeleid en extern<br/>beleid?<br/>(3 vereisten)"]:::Q
        T6["Betrokken vakgebieden<br/>Juridische, technische en<br/>ethische expertise bij<br/>bovenstaande stappen<br/>betrokken?<br/>(1 vereiste)"]:::Q
        T7["Eindoordeel<br/>Juridische toets<br/>multidisciplinair herhaald en<br/>eindoordeel over ingebruikname<br/>vastgelegd?<br/>(1 vereiste)"]:::Q
        RES_T["Resultaat<br/>vastgelegd"]:::cat_result
        E_T --> T1
        T1 --> T2 --> T3 --> T4 --> T5 --> T6 --> T7 --> RES_T
    end

    %% ════════════════════════════════════════════════════════════
    %% Gebruik van het profileringsinstrument
    %% ════════════════════════════════════════════════════════════
    subgraph CH_G["Gebruik van het profileringsinstrument"]
        direction LR
        E_G["▶ Vanaf het NTA-scherm<br/>of Resultaat<br/>Toetsing"]:::entry
        G1["Handelingsinstructies voor behandelend medewerkers<br/>Duidelijke instructies en<br/>waarborgen voor consistente,<br/>neutrale en gecontroleerde<br/>beoordeling door medewerkers?<br/>(15 vereisten)"]:::Q
        G2["Selectie voor het besluitvormingsproces<br/>Passende verhouding<br/>willekeurige/instrumentselectie,<br/>met signalering en<br/>bezwaarprocedure?<br/>(3 vereisten)"]:::Q
        G3["Transparantie richting geraakte personen en stakeholders<br/>Geraakte personen<br/>geïnformeerd en gebruik van het<br/>instrument gepubliceerd?<br/>(2 vereisten)"]:::Q
        G4["Afspraken over evaluatie en monitoring<br/>Frequentie, uitvoering en<br/>aanleiding voor evaluatie en<br/>monitoring vooraf vastgelegd?<br/>(4 vereisten)"]:::Q
        G5["Volgen of het besluitvormingsproces verandert<br/>Doorlopend gevolgd of het<br/>proces verandert en het<br/>instrument nog voldoet?<br/>(1 vereiste)"]:::Q
        G6["Volgen van organisatorische waarborgen<br/>Organisatorische waarborgen,<br/>context en beleid periodiek<br/>herbeoordeeld en vastgelegd?<br/>(5 vereisten)"]:::Q
        G7["Volgen van prestaties en onderscheid<br/>Datakwaliteit, afwijkingen, data<br/>drift, prestaties en onderscheid<br/>periodiek gemeten?<br/>(5 vereisten)"]:::Q
        G8["Herevaluatie van de juridische toets<br/>Juridische toets na elke<br/>monitoringcyclus<br/>multidisciplinair<br/>herbeoordeeld?<br/>(1 vereiste)"]:::Q
        RES_G["Resultaat<br/>vastgelegd"]:::cat_result
        E_G --> G1
        G1 --> G2 --> G3 --> G4 --> G5 --> G6 --> G7 --> G8 --> RES_G
    end

